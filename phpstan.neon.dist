parameters:
	level: 8
	paths:
		- src
		- multisite-content-sync.php
		- uninstall.php
	scanFiles:
		- vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
		- tools/phpstan/constants.stub.php
	ignoreErrors:
		-
			message: '#Strict comparison using === between null and non-empty-string will always evaluate to false#'
			path: src/Application/Content/ContentReceiver.php
			count: 1
	treatPhpDocTypesAsCertain: false
	reportUnmatchedIgnoredErrors: true
