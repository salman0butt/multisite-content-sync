{
  "name": "salman0butt/multisite-content-sync",
  "description": "Secure content synchronization between independent WordPress sites.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-openssl": "*"
  },
  "require-dev": {
    "php-stubs/wordpress-stubs": "^7.0",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.3"
  },
  "autoload": {
    "psr-4": {
      "SalmanButt\\Multisite_Content_Sync\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SalmanButt\\Multisite_Content_Sync\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "check": [
      "@lint",
      "@cs",
      "@analyse",
      "@test"
    ],
    "lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
    "cs": "phpcs",
    "cs:fix": "phpcbf",
    "analyse": "phpstan analyse --memory-limit=1G",
    "test": "phpunit"
  }
}
